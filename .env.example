# نمونهٔ تنظیمات توسعهٔ محلی؛ credential واقعی را فقط در .env نادیده‌گرفته‌شده بگذارید.
# پس از کپی به .env، DATABASE_URL و POSTGRES_PASSWORD را با مقادیر محلی تنظیم کنید.
# Compose در صورت unset یا خالی بودن POSTGRES_PASSWORD خطا می‌دهد.
DATABASE_URL=
POSTGRES_DB=franchise_plus_dev
POSTGRES_USER=fp_dev
POSTGRES_PASSWORD=
