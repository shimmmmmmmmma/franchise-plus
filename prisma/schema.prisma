generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_PHONE
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PHONE_CHANGE
  RECOVERY
}

enum AuditResult {
  ALLOW
  DENY
  SUCCESS
  FAILURE
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  publicId         String     @unique @map("public_id") @db.VarChar(32)
  mobileE164       String     @unique @map("mobile_e164") @db.VarChar(16)
  email            String?    @unique @db.VarChar(254)
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  status           UserStatus @default(PENDING_PHONE)
  mobileVerifiedAt DateTime?  @map("mobile_verified_at") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  roles                UserRole[]    @relation("AssignedRoles")
  grantedRoles         UserRole[]    @relation("RoleGrantor")
  sessions             Session[]
  auditEvents          AuditEvent[]  @relation("AuditActor")
  ownedSupportCases    SupportCase[] @relation("SupportCaseOwner")
  assignedSupportCases SupportCase[] @relation("SupportCaseExpert")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(64)
  titleFa   String     @map("title_fa") @db.VarChar(120)
  isSystem  Boolean    @default(true) @map("is_system")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  userRoles UserRole[]
  sessions  Session[]  @relation("SessionActiveRole")

  @@map("roles")
}

model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  user      User  @relation("AssignedRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  activeRoleId  String?   @map("active_role_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  ipHash        String?   @map("ip_hash") @db.Char(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeRole Role? @relation("SessionActiveRole", fields: [activeRoleId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeRoleId])
  @@map("sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  mobileE164 String     @map("mobile_e164") @db.VarChar(16)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.Char(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  lockedAt   DateTime?  @map("locked_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobileE164, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  actorRoleCode String?     @map("actor_role_code") @db.VarChar(64)
  action        String      @db.VarChar(120)
  entityType    String      @map("entity_type") @db.VarChar(80)
  entityId      String      @map("entity_id") @db.VarChar(80)
  before        Json?       @db.JsonB
  after         Json?       @db.JsonB
  changedFields String[]    @default([]) @map("changed_fields")
  requestId     String?     @map("request_id") @db.VarChar(80)
  sessionIdHash String?     @map("session_id_hash") @db.Char(64)
  ipHash        String?     @map("ip_hash") @db.Char(64)
  purposeCode   String?     @map("purpose_code") @db.VarChar(80)
  reasonText    String?     @map("reason_text") @db.VarChar(500)
  result        AuditResult @default(SUCCESS)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("audit_events")
}

model Industry {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  slug      String   @unique @db.VarChar(120)
  titleFa   String   @map("title_fa") @db.VarChar(160)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  parent   Industry?  @relation("IndustryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Industry[] @relation("IndustryTree")

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("industries")
}

model SupportCase {
  id           String   @id @default(uuid()) @db.Uuid
  publicId     String   @unique @map("public_id") @db.VarChar(32)
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  expertUserId String?  @map("expert_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner  User  @relation("SupportCaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  expert User? @relation("SupportCaseExpert", fields: [expertUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([expertUserId, createdAt(sort: Desc)])
  @@map("support_cases")
}
